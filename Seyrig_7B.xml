               <bibl><ptr target="Zacos1"/>, p. <citedRange unit="page">83-84</citedRange>, no. <citedRange unit="entry">93a-d</citedRange></bibl>;
               Münzkabinett des Kunsthistorischen Museums, Vienne, MK 29 = <bibl><ptr target="BBÖ1"/>, p. <citedRange unit="page">97-98</citedRange>, no. <citedRange unit="entry">24</citedRange></bibl>.
            </p>
         </div>
