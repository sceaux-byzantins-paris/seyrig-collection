            <p xml:id="footnote-1">
                        <!--  [1]. LAURENT, <hi rend="italic">Corpus</hi>, V, 1678,
                          corrigé par N. OlKONOMIDÈS, <hi rend="italic">Spéculum</hi>, 49, 1974, p. 746, d’après un sceau DO 58.106.446.-->
                      </p>
         </div>
