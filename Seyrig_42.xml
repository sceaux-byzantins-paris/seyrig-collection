                      <ab ana="gen">                    
                          <lb n="1"/><rs type="invocation" ref="#inv001"><expan><ex>Θεοτόκε βοήθει</ex></expan></rs> Σεργίου
                          </ab>
</div>
                    
                  <div type="textpart" subtype="face" n="rev" rend="monogram-cross" xml:lang="grc">
