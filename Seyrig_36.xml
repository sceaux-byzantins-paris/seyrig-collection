      <body><!-- dans un second temps, il faudra voir si  rajouter l'identification proposée avec Xylinitès -->
         <div type="edition" subtype="editorial" xml:space="preserve">
                  <div type="textpart" subtype="face" n="obv" rend="monogram-cross" xml:lang="grc">
          <ab ana="dat">
             <lb n="1"/><rs type="invocation" ref="#inv002"><expan><ex>Θεοτόκε βοήθει</ex></expan> <supplied reason="lost">τ</supplied>ῷ <supplied reason="lost">σῷ</supplied> δούλῳ</rs>
           </ab>
         </div>
                  <div type="textpart" subtype="face" n="rev" rend="linear" xml:lang="grc">
                      <ab ana="dat">
               <lb n="2"/><supplied reason="lost">+ Νικ</supplied>
               <lb n="3" break="no"/>ήτᾳ <rs type="dignity" ref="#d0047">πα
               <lb n="4" break="no"/>τρικίῳ</rs>
               <lb n="5"/><expan><abbr><am>S</am></abbr><ex>καὶ</ex></expan> <rs type="dignity" ref="#d0038">μαγίσ
               <lb n="6" break="no"/>τρῳ</rs> +
                   </ab>
                  </div>
                  </div>
         <div type="edition" subtype="diplomatic" xml:space="preserve">
                  <div type="textpart" subtype="face" n="obv" rend="monogram-cross" xml:lang="grc">
                      <ab>
                         <lb n="1"/>Κ-̣τ.-η-β-θ .-..-̣-λω
                      </ab>
                  </div>
                  <div type="textpart" subtype="face" n="rev" rend="linear" xml:lang="grc">
                      <ab>
                         <lb n="2"/>.... 
                         <lb n="3"/>η̣ταπα
                         <lb n="4"/>τ̣ρικιω
                         <lb n="5"/>̣μαγισ
                         <lb n="6"/>τ̣ρ̣ω̣
                      </ab>
                  </div>
              </div>
         <div type="apparatus">
            <p/>
            <!-- propos replacé dans l'état de conservation; l'apparat critique ne s'écrit pas comme ceci en SigiDoc xml, et en effet EFES ne l'a pas visualisé -->
         </div>
         <div type="translation">
            <p>Θεοτόκε βοήθει τῷ σῷ δούλῳ / + Νικήτᾳ πατρικίῳ καὶ μαγίστρῳ +.</p>
            <p xml:lang="en">Mother of God help your servant Niketas, patrikios and magistros.</p>
            <p xml:lang="fr">Mère de Dieu aide ton serviteur Nicétas, patrice et magistre.</p>
         </div>
         <div type="commentary" subtype="text">
            <p><!--Étant donné que la dignité de magistre était
                      parcimonieusement attribuée à cette époque, peut-être à un unique bénéficiaire, notre plomb
                      pourrait avoir appartenu à Nicétas Xylinitès, attesté en 716 [1].--></p>
         </div>
         <div type="commentary" subtype="footnotes">
            <p xml:id="footnote-1">
                     <!-- [1]. THÉOPHANE, p. 400.   --> 
                  </p>
         </div>
